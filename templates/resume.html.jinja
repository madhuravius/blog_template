<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ name }} — Resume</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="favicon.png">
  <link rel="icon" href="favicon.ico">
  <style>{{ css }}</style>
  <link rel="alternate" type="text/markdown" href="index.md">
  <link rel="describedby" href="llms.txt">
</head>
<body>
  {% include "_nav.html.jinja" %}
  <header class="header-top">
    <picture>
      <source srcset="logo.webp" type="image/webp">
      <img class="portrait" src="logo.png" width="100" height="100" alt="{{ name }}" fetchpriority="high" decoding="async">
    </picture>
    <div class="header-text">
      <h1>{{ name }}</h1>
      {% if title %}
      <p class="title">{{ title }}</p>
      {% endif %}
      <ul class="contact">
        {% if contact.email %}
        <li><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></li>
        {% endif %}
        {% if contact.location %}
        <li>{{ contact.location }}</li>
        {% endif %}
        {% if contact.phone %}
        <li>{{ contact.phone }}</li>
        {% endif %}
        {% if contact.website %}
        <li><a href="{{ contact.website }}">{{ contact.website | replace("https://", "") | replace("http://", "") | replace("www.", "") | trim("/") }}</a></li>
        {% endif %}
        {% if contact.linkedin %}
        <li><a href="{{ contact.linkedin }}">{{ contact.linkedin | replace("https://", "") | replace("http://", "") | replace("www.", "") | trim("/") }}</a></li>
        {% endif %}
        {% if contact.github %}
        <li><a href="{{ contact.github }}">{{ contact.github | replace("https://", "") | replace("http://", "") | replace("www.", "") | trim("/") }}</a></li>
        {% endif %}
      </ul>
      <p class="no-print"><a href="print.pdf">Download PDF</a></p>
    </div>
  </header>

  {% if summary %}
  <section>
    <h2>Summary</h2>
    <p>{{ summary }}</p>
  </section>
  {% endif %}

  {% if skills %}
  <section>
    <h2>Technical Skills</h2>
    {% for group in skills %}
    <p class="skills-group"><strong>{{ group.category }}:</strong> {{ group["items"] | join(", ") }}</p>
    {% endfor %}
  </section>
  {% endif %}

  {% if experience %}
  <section>
    <h2>Work Experience</h2>
    {% for job in experience %}
    <article class="entry">
      <div class="entry-header">
        <h3>{{ job.company }}, {{ job.title }}</h3>
        <span class="dates">{{ job.start }} – {{ job.end }}</span>
      </div>
      {% if job.highlights %}
      <ul>
        {% for point in job.highlights %}
        <li>{{ point }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% if education %}
  <section>
    <h2>Education</h2>
    {% for school in education %}
    <article class="entry">
      <div class="entry-header">
        <h3>{{ school.school }}, {{ school.degree }}</h3>
        <span class="dates">{{ school.year }}</span>
      </div>
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% if note %}
  <p class="note">Note: {{ note }}</p>
  {% endif %}
</body>
</html>
